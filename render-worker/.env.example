# Projeto Supabase
SUPABASE_URL=https://birxcfkyuzqnhyvetbjv.supabase.co
# SERVICE ROLE — somente no servidor. NUNCA versionar, NUNCA expor no front-end.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

STORAGE_BUCKET=cards
POLL_INTERVAL_MS=15000
BATCH_SIZE=3
PORT=8787
# Protege os endpoints POST /render E POST /fetch-text (envie no header x-render-token). O dashboard
# usa o mesmo valor em WORKER_RENDER_TOKEN para o v2 do "importar do link" (render headless de SPA).
RENDER_TOKEN=defina_um_token_forte
