# PRODUCAO (Hostinger / vitrapremium.com.br): estas duas variaveis precisam existir no ambiente de
# BUILD do host (Vite injeta VITE_* em tempo de build). O .env e gitignored, entao o build do GitHub
# NAO as ve — defina-as no painel do app (Configuracoes > Variaveis de ambiente) e redeploye. Sem a
# ANON_KEY o app carrega mas mostra "Invalid API key / Chave publica ausente". Ver DEPLOY.md (raiz).
# A ANON/publishable e chave PUBLICA (protegida por RLS) — pode ir ao browser; segredos reais
# (service_role, COPILOT_GATE, tokens do worker/Meta) NUNCA vao ao front.
VITE_SUPABASE_URL=https://birxcfkyuzqnhyvetbjv.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publishable_ou_anon_aqui

# Gate token do copiloto de IA. DEVE casar com o secret COPILOT_GATE das Edges (Supabase).
# Com o secret setado, as chamadas de IA (gerar copy / extrair fatos / sugerir template) exigem este
# header; sem esta variavel, o copiloto retorna 403. Reinicie o `npm run dev` apos editar o .env.
VITE_COPILOT_GATE=seu_gate_token_aqui

# --- render-worker (opcional) -------------------------------------------------------------------
# v2 do "importar do link": quando o fetch simples volta pouco texto (site em JavaScript/SPA), o
# middleware tenta o render-worker headless (Chrome real). So ativa se AMBOS estiverem definidos;
# sem isso, o import por link funciona normal (so server-rendered). DEVE casar com o RENDER_TOKEN do
# worker. Lido pelo Node (middleware), nao pelo browser — por isso SEM prefixo VITE_.
WORKER_RENDER_URL=https://vitra-render-worker.fly.dev
WORKER_RENDER_TOKEN=mesmo_token_do_RENDER_TOKEN_do_worker

# 9:16 Premium full-res via worker. So ligue (=true) DEPOIS de hospedar o worker E aplicar a
# migration de particao (migration-render-queue-worker-route.sql). Ver render-worker/ACTIVATION.md.
VITE_WORKER_RENDER_9X16=false
